---
import PlatformIcon from './PlatformIcon.astro'
import Pill from './Pill.astro'
import { HUB_CLIENTS, STATUS_TONE, clientCopy, statusLabel } from '../data/platforms'

interface Props {
  activeId?: string
}

const { activeId } = Astro.props
---

<nav class="tiles" aria-label={clientCopy('gridAriaLabel')}>
  {
    HUB_CLIENTS.map((client) => (
      <a
        class:list={['tile', { active: client.id === activeId }]}
        href={`/clients/${client.id}`}
        aria-current={client.id === activeId ? 'page' : undefined}
      >
        <PlatformIcon id={client.id} class="tile-icon" />
        <span class="tile-name">{clientCopy(`${client.id}.name`)}</span>
        <span class="tile-platform">{clientCopy(`${client.id}.platform`)}</span>
        <Pill tone={STATUS_TONE[client.status]}>{statusLabel(client.status)}</Pill>
      </a>
    ))
  }
</nav>

<style>
  .tiles {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  }

  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-strong);
    color: var(--ink);
    text-align: center;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .tile:hover,
  .tile.active {
    border-color: var(--brand);
    box-shadow: var(--shadow-soft);
    transform: translateY(-3px);
  }

  .tile :global(.tile-icon) {
    width: 44px;
    height: 44px;
    margin-bottom: var(--space-2);
    color: var(--brand);
  }

  .tile-name {
    font-weight: 700;
  }

  .tile-platform {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
